# MacroMail self-host environment.
# Copy to `.env` and fill in values. Generate secrets with:
#   openssl rand -hex 32

# --- Required ---

# Directory for the local SQLite database and other on-disk state.
# Local default is ./data. The Docker image already uses /data; pin that at
# `docker run` with `-e MACROMAIL_DATA_DIR=/data` so this relative path does not win.
MACROMAIL_DATA_DIR=./data

# Signs browser sessions. Use a long random string. Changing it signs everyone out.
# Leave empty until you generate one: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM key for secrets at rest (OAuth tokens, SMTP passwords, AI keys).
# 64 hex chars (32 bytes), or a base64 32-byte key. Required outside local `next dev`.
# Leave empty until you generate one: openssl rand -hex 32
TOKEN_ENC_KEY=

# Domains this server answers for. Mailboxes can only be created on these
# domains, and mail to them is delivered internally instead of over SMTP.
# Use domains you control. Comma-separated. Default: example.com (IANA-reserved,
# so it can never capture real internet mail).
MACROMAIL_MAILBOX_DOMAINS=example.com

# --- Runtime (optional) ---

# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Optional limits ---

# Accounts this server accepts (default 500).
# MACROMAIL_MAX_USERS=500
# Stored mail per account, in MB (default 100).
# MACROMAIL_USER_STORAGE_MB=100
# Client IP for rate limits. Default: the last public X-Forwarded-For hop.
# Set to "cloudflare" only when every request arrives through Cloudflare.
# MACROMAIL_TRUSTED_PROXY=cloudflare

# --- Optional OAuth (Gmail / Outlook inbox connect, read-only) ---
# Register redirect URIs:
#   {your-origin}/api/inbox/callback/google
#   {your-origin}/api/inbox/callback/outlook

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# There is no server-wide SMTP account or Anthropic key. Each account saves
# its own SMTP credentials and Anthropic key in Settings (/app/settings).
